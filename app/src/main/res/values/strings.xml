    <!-- FAQ / User Guide screen -->
    <string name="screen_faq">User Guide</string>
    <string name="tab_faq">Guide</string>
    <string name="home_desc_faq">How to use the app</string>

    <string name="faq_section_general">General</string>
    <string name="faq_q_what_is_app">What is Distro-Ku?</string>
    <string name="faq_a_what_is_app">Distro-Ku is a fully offline distribution management app for small businesses. Record stock, create invoices, manage resellers, and track finances — all stored on your device with no internet required.</string>
    <string name="faq_q_need_internet">Does it require an internet connection?</string>
    <string name="faq_a_need_internet">No. All data is stored locally on your device. Internet is only needed for the initial licence activation.</string>
    <string name="faq_q_data_backup">How do I back up my data?</string>
    <string name="faq_a_data_backup">Manual backup is not yet available in-app. Avoid clearing app data or factory resetting your device without a device backup to prevent data loss.</string>

    <string name="faq_section_products">Products</string>
    <string name="faq_q_add_product">How do I add a new product?</string>
    <string name="faq_a_add_product">Open Products from the home screen, tap the + button in the bottom-right corner, fill in the name, SKU, unit, cost price, and selling price, then tap Save Product.</string>
    <string name="faq_q_what_is_sku">What is SKU?</string>
    <string name="faq_a_what_is_sku">SKU (Stock Keeping Unit) is a unique code for each product that distinguishes products with similar names. Example: AQUA-600ML, AQUA-1500ML.</string>
    <string name="faq_q_threshold">What is the Restock Alert Threshold?</string>
    <string name="faq_a_threshold">The minimum stock level before a low-stock alert appears. When a product\'s stock reaches or falls below this number, its card turns red on the Stoking and Stock Opname screens.</string>

    <string name="faq_section_stoking">Stoking</string>
    <string name="faq_q_what_is_stoking">What is Stoking?</string>
    <string name="faq_a_what_is_stoking">Stoking records incoming stock additions. Select a product, enter the quantity, pick a date, and save. The product\'s stock balance increases immediately.</string>
    <string name="faq_q_auto_price">Why is the unit price filled automatically?</string>
    <string name="faq_a_auto_price">The unit price automatically uses the Selling Price set in the Products menu, ensuring consistency across all records. To change the reference price, update the product\'s selling price in Products.</string>

    <string name="faq_section_opname">Stock Opname</string>
    <string name="faq_q_what_is_opname">What is Stock Opname?</string>
    <string name="faq_a_what_is_opname">Stock Opname reconciles system stock with the physical count in your warehouse. Enter the physical count for each product, review the discrepancy column, then save to apply all adjustments at once.</string>
    <string name="faq_q_when_opname">When should I run Stock Opname?</string>
    <string name="faq_a_when_opname">Run Stock Opname periodically — weekly or monthly — or whenever you notice a discrepancy between physical goods and system records. It keeps your stock data accurate and trustworthy.</string>

    <string name="faq_section_sales">Sales &amp; Invoice</string>
    <string name="faq_q_create_invoice">How do I create a sales invoice?</string>
    <string name="faq_a_create_invoice">Open Sales, select a reseller, add products and quantities to the cart, then tap Create Invoice. Stock is immediately deducted and the invoice is saved with an auto-generated number.</string>
    <string name="faq_q_invoice_status">What do the invoice statuses mean?</string>
    <string name="faq_a_invoice_status">Unpaid: no payment received yet.\nPartial: payment has been made but the full amount is not yet settled.\nPaid: the invoice is fully settled.</string>

    <string name="faq_section_payment">Payment</string>
    <string name="faq_q_record_payment">How do I record a payment from a reseller?</string>
    <string name="faq_a_record_payment">Open Payment, select a reseller, enter the payment amount and method, then tap Payment. The system uses FIFO — oldest invoices are settled first. A preview of the allocation is shown before you confirm.</string>
    <string name="faq_q_share_receipt">How do I share a payment receipt?</string>
    <string name="faq_a_share_receipt">After recording a payment, a Share option appears. The app generates a PDF receipt which you can send directly via WhatsApp or any other app.</string>

    <string name="faq_section_reseller">Resellers &amp; Returns</string>
    <string name="faq_q_add_reseller">How do I register a reseller?</string>
    <string name="faq_a_add_reseller">Open Resellers, tap + to create a new entry. Fill in the name, phone number, and optional address. You can also import contact details directly from your phone\'s contacts with one tap.</string>
    <string name="faq_q_return">How do I process a product return?</string>
    <string name="faq_a_return">Open Returns from the home screen, select a reseller, add return items with quantities and a reason (Unsold, Defect, or Other), then submit. Return values are automatically deducted from revenue in the Ledger.</string>

    <string name="faq_section_ledger">Ledger</string>
    <string name="faq_q_what_is_ledger">What is shown in the Ledger?</string>
    <string name="faq_a_what_is_ledger">The Ledger shows a financial summary: Revenue (total invoiced), Collected (payments received), Outstanding (unpaid balance), and Gross Profit. Filter by Today, This Week, This Month, This Year, or All Time.</string>
    <string name="faq_q_gross_profit">How is Gross Profit calculated?</string>
    <string name="faq_a_gross_profit">Gross Profit = Total revenue − Cost of goods sold − Return values. It is an estimated profit margin before other operating costs such as transport or overheads.</string>

    <string name="faq_section_settings">Settings</string>
    <string name="faq_q_pin_lock">What is PIN Lock?</string>
    <string name="faq_a_pin_lock">PIN Lock adds a 4-digit security lock to the app. Enable it in Settings → Security → App PIN Lock. Once set, the PIN is required every time the app is opened.</string>
    <string name="faq_q_reset_data">What happens when I Reset All Data?</string>
    <string name="faq_a_reset_data">All products, resellers, transactions, stock records, and payment history are permanently deleted. Business settings and company info are kept. This action cannot be undone — use it only when absolutely necessary.</string>

