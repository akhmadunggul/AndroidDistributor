    <!-- Layar FAQ / Panduan Penggunaan -->
    <string name="screen_faq">Panduan Penggunaan</string>
    <string name="tab_faq">Panduan</string>
    <string name="home_desc_faq">Cara menggunakan aplikasi</string>

    <string name="faq_section_general">Umum</string>
    <string name="faq_q_what_is_app">Apa itu Distro-Ku?</string>
    <string name="faq_a_what_is_app">Distro-Ku adalah aplikasi manajemen distribusi offline untuk usaha kecil. Catat stok, buat invoice, kelola reseller, dan pantau keuangan — semuanya tersimpan di perangkat Anda tanpa memerlukan internet.</string>
    <string name="faq_q_paperless">Apakah aplikasi ini paperless?</string>
    <string name="faq_a_paperless">Ya. Distro-Ku dirancang untuk mengelola seluruh transaksi distribusi secara digital tanpa selembar kertas pun. Invoice, struk pembayaran, dan laporan keuangan semuanya tersedia dalam format digital dan dapat dibagikan langsung via WhatsApp atau email.</string>
    <string name="faq_q_need_internet">Apakah perlu koneksi internet?</string>
    <string name="faq_a_need_internet">Tidak. Seluruh data disimpan secara lokal di perangkat Anda. Koneksi internet hanya diperlukan saat aktivasi lisensi dan backup data ke cloud.</string>
    <string name="faq_q_data_backup">Bagaimana cara mencadangkan dan memulihkan data?</string>
    <string name="faq_a_data_backup">Isi email di Pengaturan → Backup &amp; Pulihkan, lalu ketuk Backup Sekarang. Aplikasi otomatis mencadangkan data ke cloud setiap minggu. Jika HP factory reset atau ganti HP baru, instal aplikasi, isi email yang sama, lalu ketuk Pulihkan dari Cloud — data Anda akan pulih sepenuhnya.</string>

    <string name="faq_section_license">Lisensi</string>
    <string name="faq_q_how_activate">Cara mengaktifkan lisensi?</string>
    <string name="faq_a_how_activate">Saat pertama membuka aplikasi, masukkan kunci lisensi yang diterima setelah pembelian. Aktivasi memerlukan koneksi internet dan mengikat lisensi ke satu perangkat.</string>
    <string name="faq_q_license_duration">Berapa lama masa berlaku lisensi?</string>
    <string name="faq_a_license_duration">Tersedia paket 1 bulan dan 1 tahun. Sisa hari ditampilkan di layar aktivasi. Peringatan muncul 7 hari sebelum habis agar Anda bisa memperpanjang tepat waktu.</string>
    <string name="faq_q_license_expired">Apa yang terjadi saat lisensi habis?</string>
    <string name="faq_a_license_expired">Saat lisensi habis, aplikasi terkunci dan semua fitur tidak bisa diakses sampai diperbarui. Data Anda tetap aman dan tidak akan dihapus. Hubungi admin via WhatsApp untuk memperpanjang.</string>
    <string name="faq_q_license_multidevice">Bisakah satu lisensi dipakai di beberapa HP?</string>
    <string name="faq_a_license_multidevice">Tidak. Setiap lisensi hanya berlaku untuk satu perangkat. Jika perlu pindah ke HP baru, hubungi admin — migrasi ke perangkat baru dapat diatur.</string>

    <string name="faq_section_products">Produk</string>
    <string name="faq_q_add_product">Cara menambah produk baru?</string>
    <string name="faq_a_add_product">Buka menu Produk dari halaman utama, ketuk tombol + di pojok kanan bawah, isi nama, SKU, satuan, harga modal, dan harga jual, lalu ketuk Simpan Produk.</string>
    <string name="faq_q_what_is_sku">Apa itu SKU?</string>
    <string name="faq_a_what_is_sku">SKU (Stock Keeping Unit) adalah kode unik untuk setiap produk yang membedakan produk dengan nama serupa. Contoh: AQUA-600ML, AQUA-1500ML.</string>
    <string name="faq_q_threshold">Apa itu Batas Peringatan Restock?</string>
    <string name="faq_a_threshold">Angka minimal stok sebelum peringatan muncul. Jika stok produk mencapai atau di bawah angka ini, kartunya akan berwarna merah di layar Tambah Stok dan Cek Stok.</string>

    <string name="faq_section_stoking">Tambah Stok</string>
    <string name="faq_q_what_is_stoking">Apa itu menu Tambah Stok?</string>
    <string name="faq_a_what_is_stoking">Menu Tambah Stok digunakan untuk mencatat barang yang baru masuk. Pilih produk, masukkan jumlah, pilih tanggal, lalu simpan. Stok produk langsung bertambah.</string>
    <string name="faq_q_auto_price">Mengapa harga satuan terisi otomatis?</string>
    <string name="faq_a_auto_price">Harga satuan otomatis mengacu pada Harga Jual yang ditetapkan di menu Produk, untuk menjaga konsistensi data. Jika perlu mengubah harga referensi, perbarui harga jual produk di menu Produk.</string>

    <string name="faq_section_opname">Cek Stok</string>
    <string name="faq_q_what_is_opname">Apa itu menu Cek Stok?</string>
    <string name="faq_a_what_is_opname">Menu Cek Stok digunakan untuk mencocokkan jumlah barang di sistem dengan barang fisik yang ada. Masukkan jumlah fisik setiap produk, lihat kolom selisih, lalu simpan untuk memperbarui stok sekaligus.</string>
    <string name="faq_q_when_opname">Kapan sebaiknya melakukan Cek Stok?</string>
    <string name="faq_a_when_opname">Lakukan Cek Stok secara rutin — seminggu atau sebulan sekali — atau saat ada perbedaan antara barang fisik dengan catatan di aplikasi. Ini menjaga data stok tetap akurat.</string>

    <string name="faq_section_sales">Penjualan &amp; Nota</string>
    <string name="faq_q_create_invoice">Cara membuat nota penjualan?</string>
    <string name="faq_a_create_invoice">Buka menu Penjualan, pilih pembeli, tambahkan produk dan jumlah ke keranjang, lalu ketuk Buat Nota. Stok langsung berkurang dan nota tersimpan dengan nomor otomatis.</string>
    <string name="faq_q_invoice_status">Apa arti status nota?</string>
    <string name="faq_a_invoice_status">Belum Bayar: belum ada pembayaran.\nSebagian: sudah ada pembayaran tapi belum lunas.\nLunas: seluruh tagihan sudah dilunasi.</string>

    <string name="faq_section_payment">Pembayaran</string>
    <string name="faq_q_record_payment">Cara mencatat pembayaran dari reseller?</string>
    <string name="faq_a_record_payment">Buka menu Catat Pembayaran, pilih reseller, masukkan jumlah dan metode pembayaran, lalu ketuk Catat Pembayaran. Aplikasi otomatis melunasi nota yang paling lama terlebih dahulu. Rincian pembayaran ditampilkan sebelum dikonfirmasi.</string>
    <string name="faq_q_share_receipt">Cara berbagi invoice atau struk pembayaran?</string>
    <string name="faq_a_share_receipt">Setelah membuat nota atau mencatat pembayaran, pilih opsi Bagikan. Aplikasi membuat PDF yang bisa dikirim via WhatsApp, WhatsApp Business, Email (alamat email reseller terisi otomatis jika sudah disimpan), atau aplikasi lain. Nota dan struk lama juga bisa dibagikan ulang langsung dari Buku Kas dengan mengetuk baris transaksinya.</string>

    <string name="faq_section_reseller">Reseller &amp; Retur</string>
    <string name="faq_q_add_reseller">Cara mendaftarkan atau mengedit reseller?</string>
    <string name="faq_a_add_reseller">Buka menu Reseller, ketuk + untuk menambah baru atau ikon pensil pada kartu yang sudah ada untuk mengedit. Isi nama, nomor HP, alamat, dan email. Alamat email digunakan untuk mengisi otomatis penerima saat berbagi nota via email. Nomor HP bisa diimpor dari kontak HP hanya dengan satu ketukan.</string>
    <string name="faq_q_return">Cara memproses retur produk?</string>
    <string name="faq_a_return">Buka menu Retur dari halaman utama, pilih reseller, tambahkan item retur beserta jumlah dan alasan (Tidak Terjual, Cacat/Rusak, atau Lainnya), lalu kirim. Nilai retur otomatis dikurangi dari omzet di Buku Kas.</string>

    <string name="faq_section_ledger">Buku Kas</string>
    <string name="faq_q_what_is_ledger">Apa yang ditampilkan di Buku Kas?</string>
    <string name="faq_a_what_is_ledger">Buku Kas menampilkan ringkasan keuangan untuk periode yang dipilih: Omzet (total tagihan), Diterima (pembayaran terkumpul), Total Pembelian (pembayaran ke suplier), Laba Kotor, dan Piutang (saldo belum dibayar). Tersedia filter: Hari Ini, Minggu Ini, Bulan Ini, Tahun Ini, dan Semua.</string>
    <string name="faq_q_gross_profit">Bagaimana Laba Kotor dihitung?</string>
    <string name="faq_a_gross_profit">Laba Kotor = Total omzet − Harga modal produk terjual − Nilai retur. Ini adalah estimasi margin keuntungan sebelum biaya operasional lain. Pembayaran ke suplier dicatat terpisah di kartu Total Pembelian.</string>

    <string name="faq_section_supplier">Suplier &amp; Pembelian</string>
    <string name="faq_q_what_is_supplier">Apa itu menu Suplier?</string>
    <string name="faq_a_what_is_supplier">Menu Suplier digunakan untuk mendaftarkan produsen atau pemasok tempat Anda membeli barang. Simpan nama, nomor HP, alamat, email, dan catatan. Ketuk ikon kontak di field nomor HP untuk mengimpor nomor langsung dari daftar kontak.</string>
    <string name="faq_q_record_purchase">Cara mencatat pembayaran ke suplier?</string>
    <string name="faq_a_record_purchase">Buka menu Pembayaran Pembelian dari halaman utama, pilih suplier, masukkan jumlah, pilih tanggal, tentukan metode pembayaran (Tunai / Transfer / Lainnya), tambahkan catatan opsional, lalu ketuk Kirim. Semua riwayat tampil di daftar bawah formulir.</string>
    <string name="faq_q_purchase_in_ledger">Di mana pembayaran ke suplier terlihat di Buku Kas?</string>
    <string name="faq_a_purchase_in_ledger">Total pembayaran ke suplier untuk periode yang dipilih muncul di kartu Total Pembelian pada Buku Kas. Ini membantu memantau arus kas keluar dibandingkan omzet dan laba secara sekaligus.</string>

    <string name="faq_section_settings">Pengaturan</string>
    <string name="faq_q_pin_lock">Apa itu Kunci PIN?</string>
    <string name="faq_a_pin_lock">Kunci PIN menambahkan keamanan 4 digit pada aplikasi. Aktifkan di Pengaturan → Keamanan → Kunci PIN Aplikasi. Setelah diatur, PIN diminta setiap kali aplikasi dibuka.</string>
    <string name="faq_q_reset_data">Apa yang terjadi saat Reset Semua Data?</string>
    <string name="faq_a_reset_data">Semua produk, reseller, transaksi, catatan stok, dan riwayat pembayaran dihapus permanen. Pengaturan bisnis dan info perusahaan tetap tersimpan. Tindakan ini tidak dapat dibatalkan — gunakan hanya jika benar-benar diperlukan.</string>

