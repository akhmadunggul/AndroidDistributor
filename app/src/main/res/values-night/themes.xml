<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Distributor" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Distributor.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1565C0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#1565C0</item>
        <item name="postSplashScreenTheme">@style/Theme.Distributor</item>
    </style>
</resources>
